# 只放变量名和占位符。真实值写进本地 .env 或系统环境变量,.env 不得提交。

# 大模型(OpenAI 兼容接口,默认可接 DeepSeek,也可换通义等)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=deepseek-chat
LLM_TIMEOUT=60

# ima 官方接口凭证(仅 ImaRetriever 使用)
IMA_OPENAPI_CLIENTID=your_ima_client_id_here
IMA_OPENAPI_APIKEY=your_ima_api_key_here

# 检索实现:local(开发期)或 ima(提交前)
RETRIEVER=local

# 本地知识库副本根目录(只读)
LOCAL_KB_ROOT=../华为PC全板块深度知识库_v7
